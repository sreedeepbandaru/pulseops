# Copy this file to .env and fill in YOUR values. NEVER commit a real .env.
#   cp .env.example .env
# The defaults below are only for local Docker Compose (not secrets).
DATABASE_URL=postgresql://pulseops:pulseops@db:5432/pulseops
REDIS_URL=redis://redis:6379/0
SIMULATE=false
PORT=5000
# AWS / GitHub (fill in only on the EC2 server or in GitHub Secrets, never here):
# AWS_REGION=us-east-1
# ECR_WEB_URL=123456789012.dkr.ecr.us-east-1.amazonaws.com/pulseops-web
# ECR_WORKER_URL=123456789012.dkr.ecr.us-east-1.amazonaws.com/pulseops-worker
